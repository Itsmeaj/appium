{
  "name": "@itsmeaj/appium-linux-driver",
  "version": "0.1.1",
  "description": "AT-SPI2-based Appium driver for Linux desktop application automation",
  "keywords": [
    "appium",
    "linux",
    "AT-SPI2"
  ],
  "main": "./build/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Itsmeaj/appium.git"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "files": [
    "build/index.js",
    "build/lib",
    "doctor",
    "docs",
    "index.js",
    "lib"
  ],
  "appium": {
    "driverName": "atspi2",
    "automationName": "AtSpi2",
    "platformNames": [
      "Linux"
    ],
    "mainClass": "AtSpi2Driver",
    "doctor": {
      "checks": [
        "./doctor/linux-platform.js",
        "./doctor/native-runtime.js",
        "./doctor/desktop-session.js",
        "./doctor/wayland-prerequisites.js"
      ]
    }
  },
  "author": "Ajay <send2ajay03@gmail.com>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/Itsmeaj/appium/issues"
  },
  "homepage": "https://github.com/Itsmeaj/appium#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@babel/runtime": "^7.0.0",
    "@stdspa/stdspalinux_temp": "^0.0.10",
    "asyncbox": "^2.0.2",
    "bluebird": "^3.7.2",
    "dbus-next": "^0.10.2",
    "lodash": "^4.17.4",
    "lru-cache": "^7.7.1",
    "node-gyp": "^11.5.0",
    "sharp": "^0.34.3",
    "source-map-support": "^0.x",
    "uuid": "^8.3.2",
    "@xmldom/xmldom": "^0.8.10",
    "xpath.js": "^1.1.0"
  },
  "peerDependencies": {
    "appium": ">=2.0.0 <4.0.0"
  },
  "scripts": {
    "build": "gulp transpile",
    "prepare": "gulp transpile && gulp prepublish",
    "mocha": "mocha",
    "test": "gulp once",
    "e2e-test": "gulp e2e-test",
    "watch": "gulp watch",
    "precommit-msg": "echo 'Pre-commit checks...' && exit 0",
    "precommit-test": "REPORTER=dot gulp once",
    "lint": "gulp eslint",
    "lint:fix": "gulp eslint --fix",
    "test:package": "npm pack --dry-run"
  },
  "pre-commit": [
    "precommit-msg",
    "precommit-test"
  ],
  "devDependencies": {
    "@appium/eslint-config-appium": "^5.0.0",
    "@appium/gulp-plugins": "^6.0.0",
    "@babel/core": "^7.16.0",
    "@babel/eslint-parser": "^7.16.3",
    "appium": "^3.4.0",
    "chai": "^4.1.2",
    "chai-as-promised": "^7.1.1",
    "eslint": "^7.32.0",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-mocha": "^9.0.0",
    "eslint-plugin-promise": "^6.0.0",
    "gulp": "^4.0.0",
    "mocha": "^9.0.0",
    "pre-commit": "^1.1.3",
    "sinon": "^13.0.0",
    "webdriverio": "^7.0.0"
  },
  "packageManager": "yarn@1.22.22"
}
